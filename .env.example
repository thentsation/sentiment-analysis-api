HOST=0.0.0.0
PORT=8000
# The server options are in the `serve:` block of src/main.tvx; set one of these to override it:
# TELVAX_LOG_FORMAT=text
# TELVAX_RATE_LIMIT=100/min
# TELVAX_CORS=*
# TELVAX_METRICS=1
# TELVAX_SECURITY_HEADERS=1
ADMIN_TOKEN=
CACHE_MAXSIZE=10000
CACHE_TTL_SECONDS=300
JOB_STORE_MAXSIZE=100
# Jobs are kept in PostgreSQL when this is set (needs TELVAX_LIVE=1)
DATABASE_URL=
TELVAX_LIVE=
