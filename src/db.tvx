# PostgreSQL storage of the batch jobs. With DATABASE_URL empty nothing is written.
import std.db.postgres.PostgresClient

from config import database_url
from models.models import JobRow
from vendor.leia.leia import Scores

let db = PostgresClient.connect(database_url)

fn persistent() -> Bool:
    not database_url.is_empty()

fn persist[P](sql: Text, params: P):
    if persistent():
        match db.execute(sql, params):
            case Ok(_):
                pass
            case Err(message):
                std.log.error("postgres: the statement failed", {"message": message})

# Makes the table; it runs once, before the server listens (`on_start` in src/main.tvx).
fn init_db():
    persist("CREATE TABLE IF NOT EXISTS sentiment_jobs (id TEXT PRIMARY KEY, language TEXT NOT NULL, total INTEGER NOT NULL, processed INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'pending', results JSONB NOT NULL DEFAULT '{}'::jsonb, created_at TIMESTAMPTZ NOT NULL DEFAULT now())", [])

fn insert_job(id: Text, language: Text, total: Int):
    persist("INSERT INTO sentiment_jobs (id, language, total) VALUES ($1, $2, $3) ON CONFLICT (id) DO NOTHING", (id, language, total))

fn update_status(id: Text, status: Text):
    persist("UPDATE sentiment_jobs SET status = $1 WHERE id = $2", (status, id))

fn append_result(id: Text, text: Text, scores: Scores, processed: Int):
    persist("UPDATE sentiment_jobs SET results = results || $1::jsonb, processed = $2 WHERE id = $3", (std.json.stringify(std.map.from_entries([(text, scores)])), processed, id))

fn fetch_job(id: Text) -> JobRow?:
    if not persistent():
        return None
    let sql = "SELECT id, language, total, processed, status, results::text AS results FROM sentiment_jobs WHERE id = $1"
    let found: Result[List[JobRow], Text] = db.query(sql, [id])
    match found:
        case Err(message):
            std.log.error("postgres: the query failed", {"message": message})
            None
        case Ok(rows):
            rows.first()
