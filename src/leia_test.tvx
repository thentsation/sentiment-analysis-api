from vendor.leia.leia import analyze, Scores

fn close(a: Float, b: Float) -> Bool:
    std.math.abs(a - b) < 0.00001

fn check(text: Text, pt: Bool, compound: Float, pos: Float, neu: Float, neg: Float):
    let s = analyze(text, "pt" if pt else "en")
    assert(close(s.compound, compound))
    assert(close(s.pos, pos))
    assert(close(s.neu, neu))
    assert(close(s.neg, neg))

fn test_golden_00_en():
    check("I love this!", False, 0.6696, 0.818, 0.182, 0.0)

fn test_golden_01_en():
    check("I hate this!", False, -0.6114, 0.0, 0.2, 0.8)

fn test_golden_02_en():
    check("This is not good.", False, -0.3412, 0.0, 0.555, 0.445)

