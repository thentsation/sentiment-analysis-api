# Sentiment Analysis API: VADER for English, LeIA for Portuguese, with a cache, asynchronous
# batch jobs, Server-Sent Events and the same routes as the Python service.
#
# Run: telvax serve main.tvx --port 8000

import std.http.Status

from db import init_db

# How the service is served. The variables are the ones of the Python service where the value has the same form
# (the log format is `json` or `text`); the flags and the TELVAX_* variables of `telvax serve` still win.
serve:
    on_start: [init_db]
    metrics: True
    log_format: env("LOG_FORMAT", "json")
    log_level: env("LOG_LEVEL", "info")
    cors: env("CORS_ORIGINS", "*")
    rate_limit: env("RATE_LIMIT", "100/min")
    security_headers: True
    process_time_header: True
    error_format: "detail"

from config import version
from models.models import HealthResponse, RootResponse
from routes.sentiment_routes import analyze_one, analyze_multiple, sentiment_classes, analyze_statistics, invalidate_cache, submit_batch, get_results, analyze_stream

@endpoint(GET, "/")
fn root() -> Result[RootResponse, Status]:
    Ok(RootResponse(
        name: "Sentiment Analysis API",
        version: version,
        docs: "/docs",
        health: "/health",
        metrics: "/metrics",
        endpoints: [
            "/v1/analyze",
            "/v1/analyze_batch",
            "/v1/analyze_multiple",
            "/v1/analyze_statistics",
            "/v1/analyze_stream",
            "/v1/cache",
            "/v1/results/{job_id}",
            "/v1/sentiment_classes",
        ],
    ))

@endpoint(GET, "/health")
fn health() -> Result[HealthResponse, Status]:
    Ok(HealthResponse(status: "ok"))
